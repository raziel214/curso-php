{
  "name": "raziel214/curso-php",
  "description": "Hoja de vida + panel administrativo en PHP con arquitectura limpia",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "illuminate/database": "^10.0",
    "laminas/laminas-diactoros": "^3.3",
    "laminas/laminas-httphandlerrunner": "^2.10",
    "psr/container": "^1.1 || ^2.0",
    "aura/router": "^3.3",
    "twig/twig": "^3.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "serve": "php -S localhost:8000 -t public",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
