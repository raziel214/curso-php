{# Parámetros: name, label, type (text|textarea|number|email|password), values, errors, help #}
{% set value = values[name] ?? '' %}
{% set error = errors[name] ?? null %}
<div class="mb-3">
  <label for="{{ name }}" class="form-label">{{ label }}</label>
  {% if type == 'textarea' %}
    <textarea id="{{ name }}" name="{{ name }}" rows="4" class="form-control{{ error ? ' is-invalid' }}">{{ value }}</textarea>
  {% else %}
    <input id="{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ type == 'password' ? '' : value }}"
           class="form-control{{ error ? ' is-invalid' }}"{% if type == 'number' %} min="0"{% endif %}>
  {% endif %}
  {% if error %}<div class="invalid-feedback">{{ error }}</div>{% endif %}
  {% if help is defined and help %}<div class="form-text">{{ help }}</div>{% endif %}
</div>
