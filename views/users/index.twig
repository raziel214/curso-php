{% extends "layout.twig" %}
{% block title %}Usuarios{% endblock %}
{% block content %}
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Usuarios</h1>
    <a href="/admin/users/new" class="btn btn-primary">Nuevo usuario</a>
  </div>
  <table class="table table-hover align-middle">
    <thead><tr><th>Email</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    {% for user in users %}
      <tr>
        <td>{{ user.email }}{% if user.id == currentUserId %} <span class="badge text-bg-info">tú</span>{% endif %}</td>
        <td class="text-end text-nowrap">
          <a href="/admin/users/{{ user.id }}/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
          {% if user.id != currentUserId %}
            {% include 'partials/delete_button.twig' with {action: '/admin/users/' ~ user.id ~ '/delete'} %}
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endblock %}
