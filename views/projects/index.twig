{% extends "layout.twig" %}
{% block title %}Proyectos{% endblock %}
{% block content %}
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Proyectos</h1>
    <a href="/admin/projects/new" class="btn btn-primary">Nuevo proyecto</a>
  </div>
  <table class="table table-hover align-middle">
    <thead><tr><th>Título</th><th>Descripción</th><th>Tecnologías</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    {% for project in projects %}
      <tr>
        <td>{{ project.title }}</td>
        <td class="text-truncate" style="max-width: 320px">{{ project.description }}</td>
        <td>{% for tech in project.technologies %}<span class="badge text-bg-secondary me-1">{{ tech }}</span>{% endfor %}</td>
        <td class="text-end text-nowrap">
          <a href="/admin/projects/{{ project.id }}/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
          {% include 'partials/delete_button.twig' with {action: '/admin/projects/' ~ project.id ~ '/delete'} %}
        </td>
      </tr>
    {% else %}
      <tr><td colspan="4" class="text-center text-muted">Aún no hay proyectos registrados.</td></tr>
    {% endfor %}
    </tbody>
  </table>
{% endblock %}
