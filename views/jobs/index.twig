{% extends "layout.twig" %}
{% block title %}Trabajos{% endblock %}
{% block content %}
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Trabajos</h1>
    <a href="/admin/jobs/new" class="btn btn-primary">Nuevo trabajo</a>
  </div>
  <table class="table table-hover align-middle">
    <thead><tr><th>Título</th><th>Descripción</th><th>Duración</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    {% for job in jobs %}
      <tr>
        <td>{{ job.title }}</td>
        <td class="text-truncate" style="max-width: 320px">{{ job.description }}</td>
        <td>{{ job.durationAsString }}</td>
        <td class="text-end text-nowrap">
          <a href="/admin/jobs/{{ job.id }}/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
          {% include 'partials/delete_button.twig' with {action: '/admin/jobs/' ~ job.id ~ '/delete'} %}
        </td>
      </tr>
    {% else %}
      <tr><td colspan="4" class="text-center text-muted">Aún no hay trabajos registrados.</td></tr>
    {% endfor %}
    </tbody>
  </table>
{% endblock %}
